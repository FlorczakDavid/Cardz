{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cardz — paquet de questions v1",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "origin": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "sourceDocument": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sourceSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 3000
      },
      "minItems": 0,
      "maxItems": 50
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,63}$"
            },
            "minItems": 0,
            "maxItems": 30
          },
          "minPlayers": {
            "type": "integer",
            "minimum": 2,
            "maximum": 20
          },
          "maxPlayers": {
            "type": "integer",
            "minimum": 2,
            "maximum": 20
          },
          "enabled": {
            "type": "boolean"
          },
          "sourceSection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sourcePage": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "originalText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "editorialNote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          }
        },
        "required": [
          "id",
          "category",
          "text",
          "tags",
          "minPlayers",
          "enabled"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000
    }
  },
  "required": [
    "schemaVersion",
    "origin",
    "title",
    "questions"
  ],
  "additionalProperties": false
}
